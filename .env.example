# OpenCGP 根级环境变量示例
# 仅用于编排/容器场景；后端细项见 backend/.env.example，前端见 frontend/.env.local

COMPOSE_PROJECT_NAME=opencgp

BACKEND_PORT=8000
FRONTEND_PORT=3001

# 后端服务地址（前端构建期使用）
VITE_API_BASE=http://127.0.0.1:8000

# 本地依赖（docker compose 场景）
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_DSN=postgresql://opencgp:opencgp@127.0.0.1:55432/opencgp
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=opencgp
