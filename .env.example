# OpenCGP root environment example (orchestration layer)
# Only the keys actually used by docker-compose.yml and the frontend build.
# Backend settings live in backend/.env.example, frontend dev overrides in frontend/.env.local

# Docker Compose project name
COMPOSE_PROJECT_NAME=opencgp

# Host ports published by docker-compose.yml
BACKEND_PORT=8000
FRONTEND_PORT=3001

# API base URL baked into the frontend bundle
VITE_API_BASE=http://127.0.0.1:8000
