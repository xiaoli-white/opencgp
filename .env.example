# ============================================================
# AI 课程工作室 · 根级环境变量示例（占位）
# 前后端各自有更细的 .env.example，详见：
#   backend/.env.example   （后端，前缀 COURSE_STUDIO_）
#   frontend/.env.local    （前端，NEXT_PUBLIC_*）
# ============================================================

# 组合式部署（docker-compose 占位）
COMPOSE_PROJECT_NAME=course-studio

# 后端服务端口
BACKEND_PORT=8000

# 前端服务端口
FRONTEND_PORT=3000
