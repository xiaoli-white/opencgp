# ============================================================
# AI 课程工作室 · 后端环境变量示例
# 复制为 .env 使用：cp .env.example .env
# 统一前缀 COURSE_STUDIO_
# ============================================================

# 应用
COURSE_STUDIO_APP_NAME=AI 课程工作室
COURSE_STUDIO_ENV=development

# 数据库（M0: sqlite；生产: postgres）
COURSE_STUDIO_DATABASE_BACKEND=sqlite
COURSE_STUDIO_DATABASE_PATH=data/course_studio.db

# 对象存储（M0: local；生产: s3 / rustfs）
COURSE_STUDIO_STORAGE_BACKEND=local
COURSE_STUDIO_STORAGE_ROOT=data/storage

# LLM（OpenAI 兼容；无 api_key 时自动降级为 dummy 占位 provider）
COURSE_STUDIO_LLM_BACKEND=openai_compat
COURSE_STUDIO_LLM_BASE_URL=
COURSE_STUDIO_LLM_API_KEY=
COURSE_STUDIO_LLM_MODEL=

# 向量检索（M0: simple；生产: pgvector）
COURSE_STUDIO_VECTORSTORE_BACKEND=simple
COURSE_STUDIO_VECTORSTORE_PATH=data/vectorstore

# 文档解析器（M0: builtin，支持 pdf/docx/md/txt）
COURSE_STUDIO_PARSER_BACKEND=builtin

# 分块策略（按段落聚合 + overlap）
COURSE_STUDIO_INGEST_CHUNK_SIZE=800
COURSE_STUDIO_INGEST_CHUNK_OVERLAP=120
COURSE_STUDIO_INGEST_MAX_FILE_MB=20

# Embedding（M0: none 仅关键词检索；开启后启用混合检索）
COURSE_STUDIO_EMBEDDING_BACKEND=none
COURSE_STUDIO_EMBEDDING_BASE_URL=
COURSE_STUDIO_EMBEDDING_API_KEY=
COURSE_STUDIO_EMBEDDING_MODEL=text-embedding-3-small
COURSE_STUDIO_EMBEDDING_DIM=1024
COURSE_STUDIO_EMBEDDING_BATCH=32
COURSE_STUDIO_EMBEDDING_TIMEOUT=20
COURSE_STUDIO_EMBEDDING_QUERY_PREFIX=
COURSE_STUDIO_HYBRID_VECTOR_WEIGHT=0.55

# Rerank（none / llm / cohere / jina / siliconflow / zhipu / tei / generic）
# none 为默认；llm 复用聊天模型打分，仅在无专用 rerank 服务时兜底，效果和成本都不如专用模型。
# cohere     https://dashboard.cohere.com/api-keys
# jina       https://jina.ai/reranker/
# siliconflow https://cloud.siliconflow.cn/account/ak
# zhipu      https://open.bigmodel.cn/usercenter/apikeys
# tei        自建 Text Embeddings Inference，无需 key
COURSE_STUDIO_RERANK_BACKEND=none
COURSE_STUDIO_RERANK_TOP_N=12
COURSE_STUDIO_RERANK_WEIGHT=0.5
COURSE_STUDIO_RERANK_TIMEOUT=20
COURSE_STUDIO_RERANK_RETRIES=2
COURSE_STUDIO_RERANK_BATCH=100
COURSE_STUDIO_RERANK_CHARS=2000
COURSE_STUDIO_RERANK_NORMALIZE=auto
COURSE_STUDIO_RERANK_RAW_SCORES=false
COURSE_STUDIO_RERANK_BASE_URL=
COURSE_STUDIO_RERANK_MODEL=
COURSE_STUDIO_RERANK_API_KEY=

# 预设示例（取消对应行注释即可）：
# Cohere
# COURSE_STUDIO_RERANK_BACKEND=cohere
# COURSE_STUDIO_RERANK_API_KEY=your-cohere-key
# COURSE_STUDIO_RERANK_BASE_URL=https://api.cohere.com/v1/rerank
# COURSE_STUDIO_RERANK_MODEL=rerank-v3.5
#
# Jina
# COURSE_STUDIO_RERANK_BACKEND=jina
# COURSE_STUDIO_RERANK_API_KEY=your-jina-key
# COURSE_STUDIO_RERANK_BASE_URL=https://api.jina.ai/v1/rerank
# COURSE_STUDIO_RERANK_MODEL=jina-reranker-v2-base-multilingual
#
# SiliconFlow
# COURSE_STUDIO_RERANK_BACKEND=siliconflow
# COURSE_STUDIO_RERANK_API_KEY=your-siliconflow-key
# COURSE_STUDIO_RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
# COURSE_STUDIO_RERANK_MODEL=BAAI/bge-reranker-v2-m3
#
# 智谱
# COURSE_STUDIO_RERANK_BACKEND=zhipu
# COURSE_STUDIO_RERANK_API_KEY=your-zhipu-key
# COURSE_STUDIO_RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/rerank
# COURSE_STUDIO_RERANK_MODEL=rerank
#
# TEI（自建）
# COURSE_STUDIO_RERANK_BACKEND=tei
# COURSE_STUDIO_RERANK_BASE_URL=http://127.0.0.1:8080/rerank
# COURSE_STUDIO_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# COURSE_STUDIO_RERANK_BATCH=32
# COURSE_STUDIO_RERANK_RAW_SCORES=false
#
# 通用服务（Cohere 兼容或常见 results/data 响应）
# COURSE_STUDIO_RERANK_BACKEND=generic
# COURSE_STUDIO_RERANK_BASE_URL=https://your-rerank.example.com/v1/rerank
# COURSE_STUDIO_RERANK_MODEL=your-model
# COURSE_STUDIO_RERANK_API_KEY=your-key

# 导出引擎（M0: builtin 占位）
COURSE_STUDIO_EXPORTER_BACKEND=builtin

# 单讲生成（检索证据条数上限 / 单条证据字符上限 / 证据总条数上限）
COURSE_STUDIO_GENERATION_TOP_K=5
COURSE_STUDIO_GENERATION_EVIDENCE_CHAR_LIMIT=600
COURSE_STUDIO_GENERATION_MAX_EVIDENCE=8
COURSE_STUDIO_GENERATION_DEFAULT_MODE=strict

# 追问 / 局部修改（对话历史条数 / 单条历史截断 / 正文截断 / 证据截断）
COURSE_STUDIO_CONVERSATION_HISTORY_LIMIT=20
COURSE_STUDIO_CONVERSATION_HISTORY_CHAR_LIMIT=400
COURSE_STUDIO_CONVERSATION_CONTENT_CHAR_LIMIT=6000
COURSE_STUDIO_CONVERSATION_EVIDENCE_CHAR_LIMIT=600
