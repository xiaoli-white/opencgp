# OpenCGP backend environment example
# Usage: cp .env.example .env
# Every key below is read by backend/app/config.py via OPENCGP_<KEY>.
# The legacy prefix COURSE_STUDIO_ is still honoured as a fallback.

# ---------- App ----------
OPENCGP_APP_NAME=OpenCGP
# development | production
OPENCGP_ENV=development

# ---------- Auth ----------
# disabled: single local owner, no login. required: email + password, approval based
OPENCGP_AUTH_MODE=required
# Token signing secret. MUST be a long random string in production: openssl rand -base64 32
OPENCGP_AUTH_SECRET=please-change-me
# Session token lifetime in hours
OPENCGP_AUTH_TOKEN_TTL_HOURS=168
# Whether a new signup needs an admin approval
OPENCGP_REQUIRE_APPROVAL=true
# Unit edit lock TTL in seconds
OPENCGP_LOCK_TTL_SECONDS=120

# ---------- Database ----------
# sqlite | postgres
OPENCGP_DATABASE_BACKEND=sqlite
# Used when backend is sqlite
OPENCGP_DATABASE_PATH=data/opencgp.db
# Used when backend is postgres, e.g. postgresql://user:pass@host:5432/opencgp
OPENCGP_DATABASE_DSN=
OPENCGP_DATABASE_POOL_SIZE=8

# ---------- Vector store ----------
# simple: SQLite FTS5 + optional vectors. postgres | pgvector: pg_trgm + optional vectors
OPENCGP_VECTORSTORE_BACKEND=simple
# Used when backend is simple
OPENCGP_VECTORSTORE_PATH=data/vectorstore
# Used when backend is postgres | pgvector (falls back to DATABASE_DSN when empty)
OPENCGP_VECTORSTORE_DSN=
OPENCGP_VECTORSTORE_POOL_SIZE=8
# Minimum keyword score a chunk must reach to be considered a hit
OPENCGP_SEARCH_MIN_SCORE=0.15

# ---------- Hybrid retrieval ----------
# rrf (rank fusion, recommended) | weighted
OPENCGP_HYBRID_FUSION=rrf
# Used when fusion is weighted
OPENCGP_HYBRID_VECTOR_WEIGHT=0.55
# RRF constant k
OPENCGP_HYBRID_RRF_K=60
# Safety valve only, not a curation knob: 0 keeps every fused chunk from a
# source. Set a positive value only to bound one pathologically over-represented
# source; normally leave this at 0.
OPENCGP_HYBRID_MAX_PER_SOURCE=0
# Upper bound of vector rows scanned per query
OPENCGP_HYBRID_MAX_VECTOR_ROWS=200000
# LSH bucket bits for the simple store (12 bits = 4096 buckets)
OPENCGP_HYBRID_LSH_BITS=12

# ---------- Ingestion ----------
OPENCGP_INGEST_CHUNK_SIZE=800
OPENCGP_INGEST_CHUNK_OVERLAP=120
OPENCGP_INGEST_MAX_FILE_MB=20
# builtin
OPENCGP_PARSER_BACKEND=builtin

# ---------- Embedding (optional, default off) ----------
# none | openai | openai_compat | hash   (hash is for offline testing only, not semantic)
OPENCGP_EMBEDDING_BACKEND=none
OPENCGP_EMBEDDING_BASE_URL=
OPENCGP_EMBEDDING_API_KEY=
OPENCGP_EMBEDDING_MODEL=text-embedding-3-small
# Vector dimension used to validate provider output; empty falls back to EMBEDDING_DIMENSION
OPENCGP_EMBEDDING_DIM=
# Alias of EMBEDDING_DIM, used only when EMBEDDING_DIM is empty
OPENCGP_EMBEDDING_DIMENSION=1024
OPENCGP_EMBEDDING_BATCH=32
OPENCGP_EMBEDDING_TIMEOUT=20
# Optional instruction prefix prepended to queries only, e.g. "query: "
OPENCGP_EMBEDDING_QUERY_PREFIX=

# ---------- Rerank (optional, default off) ----------
# none | dashscope | qwen | llm | http | cohere | jina | siliconflow | zhipu | tei | generic
OPENCGP_RERANK_BACKEND=none
OPENCGP_RERANK_API_KEY=
# Required for generic | tei | http endpoints
OPENCGP_RERANK_BASE_URL=
# Required for generic | tei | http endpoints
OPENCGP_RERANK_MODEL=
# How many retrieved candidates are sent to the reranker for scoring.
# 0 = score every candidate (explicit opt-out; not the default).
OPENCGP_RERANK_TOP_N=12
# Final blend weight of the rerank score
OPENCGP_RERANK_WEIGHT=0.5
OPENCGP_RERANK_TIMEOUT=20
OPENCGP_RERANK_RETRIES=2
# Safety ceiling for one provider request. Larger batches are split into
# several calls and never drop candidates.
OPENCGP_RERANK_BATCH=512
# Chars of each candidate sent to the reranker for scoring only; the citation
# payload keeps the full passage text.
OPENCGP_RERANK_CHARS=2000
# auto | none | sigmoid | minmax
OPENCGP_RERANK_NORMALIZE=auto
# Keep raw provider scores alongside normalised ones
OPENCGP_RERANK_RAW_SCORES=false

# ---------- Generation ----------
# Requested retrieval depth per generation. Raise it to request more evidence;
# this is a demand setting, not a hidden cap.
OPENCGP_GENERATION_TOP_K=8
# Safety valve only: 0 = honour the requested top_k without an extra ceiling.
OPENCGP_GENERATION_TOP_K_CEILING=0
# Prompt excerpt budget per evidence item. This does not remove evidence from
# the result: CitationReference.text always keeps the full passage.
OPENCGP_GENERATION_EVIDENCE_CHAR_LIMIT=600
# Safety valve only, not a curation knob: 0 = keep every retrieved chunk.
# Set a positive value only to stop a runaway retrieval from exhausting the
# prompt budget; it is not meant to select "the best N" pieces of evidence.
OPENCGP_GENERATION_MAX_EVIDENCE=0
# report: flag uncited factual paragraphs for a rewrite (default)
# attach: attach the closest retrieved evidence marker to the factual clause
# off: compute coverage but do not flag or attach
OPENCGP_GENERATION_CITATION_GAP_ACTION=report
# strict | loose   (strict requires citations only for the factual taxonomy)
OPENCGP_GENERATION_DEFAULT_MODE=strict
# Last-resort output language when neither the series nor its profile sets one
OPENCGP_GENERATION_DEFAULT_LANGUAGE=zh

# ---------- Blueprint ----------
OPENCGP_BLUEPRINT_TOP_K=6
# Empty = follow GENERATION_DEFAULT_MODE
OPENCGP_BLUEPRINT_DEFAULT_MODE=

# ---------- Evidence gate ----------
OPENCGP_EVIDENCE_GATE_ENABLED=true
OPENCGP_EVIDENCE_GATE_MIN_PASSAGES=1
OPENCGP_EVIDENCE_GATE_MIN_SCORE=0.35
OPENCGP_EVIDENCE_GATE_ALLOW_OVERRIDE=false
# A score above the threshold is necessary but not sufficient: each passage must
# also contain a distinctive term of the course topic (or an accepted alias).
OPENCGP_EVIDENCE_GATE_REQUIRE_TOPICAL_COVERAGE=true
OPENCGP_EVIDENCE_GATE_TOPIC_MAX_TERMS=8
OPENCGP_EVIDENCE_GATE_TOPIC_MIN_MATCHES=1
# JSON object: canonical term -> accepted aliases/synonyms (per language).
OPENCGP_EVIDENCE_GATE_TOPIC_ALIASES={"lean":["lean","lean4","lean 4","leanprover","精益"],"定理证明":["定理证明","形式化证明","形式化验证","自动定理证明","theorem proving","formal proof","formal verification"],"形式化证明":["形式化证明","定理证明","形式化验证","formal proof","theorem proving","formal verification"],"依赖类型":["依赖类型","依值类型","dependent type","dependent types"],"tactic":["tactic","tactics","策略","战术"],"向量数据库":["向量数据库","向量检索","vector database","vector search","vector store"],"索引调优":["索引调优","索引优化","index tuning","index optimization","hnsw","ivf"],"量化压缩":["量化压缩","量化","quantization","product quantization","pq"]}

# ---------- Web evidence fallback ----------
# Only used when the evidence gate says local knowledge-base evidence is
# insufficient. A profile can opt out with grounding.local_only=true.
OPENCGP_WEB_FALLBACK_ENABLED=true
# Maximum number of web results converted into evidence passages.
OPENCGP_WEB_FALLBACK_MAX_RESULTS=5
# Maximum characters of each web page kept as the archived cited passage.
OPENCGP_WEB_FALLBACK_MAX_CHARS=4000
# Identical queries are cached for this many seconds (retry does not pay twice).
OPENCGP_WEB_FALLBACK_CACHE_TTL=300
# How many keywords are extracted from the topic/title/context for the query.
OPENCGP_WEB_FALLBACK_MAX_KEYWORDS=8

# ---------- Conversation ----------
OPENCGP_CONVERSATION_HISTORY_LIMIT=20
OPENCGP_CONVERSATION_HISTORY_CHAR_LIMIT=400
OPENCGP_CONVERSATION_CONTENT_CHAR_LIMIT=6000
OPENCGP_CONVERSATION_EVIDENCE_CHAR_LIMIT=600

# ---------- LLM ----------
# openai_compat | dummy
OPENCGP_LLM_BACKEND=openai_compat
OPENCGP_LLM_BASE_URL=https://api.deepseek.com/v1
OPENCGP_LLM_MODEL=deepseek-chat
OPENCGP_LLM_API_KEY=
# Per-request LLM timeout in seconds. Can also be changed at runtime from the
# server settings page (stored in the runtime_config table).
OPENCGP_LLM_TIMEOUT=60

# ---------- Web search (optional) ----------
# none | deepseek | generic
OPENCGP_WEBSEARCH_BACKEND=none
OPENCGP_WEBSEARCH_URL=
OPENCGP_WEBSEARCH_API_KEY=
# JSON path of the result array for the generic backend
OPENCGP_WEBSEARCH_RESULT_PATH=results
# POST | GET
OPENCGP_WEBSEARCH_METHOD=POST
OPENCGP_WEBSEARCH_TIMEOUT=10
# Fetch full page text for top hits instead of relying on snippets
OPENCGP_WEBSEARCH_FETCH_ENABLED=true
OPENCGP_WEBSEARCH_FETCH_TOP=2
OPENCGP_WEBSEARCH_FETCH_CHARS=4000
OPENCGP_WEBSEARCH_FETCH_TIMEOUT=8

# ---------- Queue and jobs ----------
# local: in-process asyncio queue. redis: shared queue, required for multiple instances
OPENCGP_QUEUE_BACKEND=local
OPENCGP_REDIS_URL=
# 0 means this instance serves the API only and consumes no jobs (API/Worker split)
OPENCGP_JOB_CONCURRENCY=2
OPENCGP_JOB_MAX_ATTEMPTS=3
# SSE emit interval in seconds
OPENCGP_JOB_SSE_INTERVAL=0.6
OPENCGP_JOB_SSE_MAX_SECONDS=600
OPENCGP_JOB_SSE_PING_SECONDS=15
OPENCGP_JOB_BRPOP_TIMEOUT=2

# ---------- Object storage ----------
# local | s3 | rustfs
OPENCGP_STORAGE_BACKEND=local
# Used when backend is local
OPENCGP_STORAGE_ROOT=data/storage
# Used when backend is s3 | rustfs
OPENCGP_S3_ENDPOINT=
OPENCGP_S3_BUCKET=
OPENCGP_S3_REGION=us-east-1
OPENCGP_S3_ACCESS_KEY=
OPENCGP_S3_SECRET_KEY=
OPENCGP_S3_PREFIX=
OPENCGP_S3_TIMEOUT=10

# ---------- Export (EPUB / PDF) ----------
# builtin
OPENCGP_EXPORTER_BACKEND=builtin
# TTF paths used by the PDF renderer; empty = use the bundled font
OPENCGP_EXPORTER_FONT_REGULAR=
OPENCGP_EXPORTER_FONT_BOLD=
OPENCGP_EXPORTER_PDF_MARGIN_MM=18

# ---------- Image generation (optional) ----------
# none | openai_images
OPENCGP_IMAGE_BACKEND=none
OPENCGP_IMAGE_BASE_URL=https://api.openai.com/v1
OPENCGP_IMAGE_MODEL=gpt-image-1
OPENCGP_IMAGE_API_KEY=
OPENCGP_IMAGE_MAX_BYTES=8388608
OPENCGP_IMAGE_TIMEOUT=60
# Article illustration defaults; a creation profile may override them
OPENCGP_ASSETS_AUTO_IMAGES=true
OPENCGP_ASSETS_MAX_IMAGES=3

# ---------- Video generation (optional, Remotion) ----------
# none | remotion
OPENCGP_VIDEO_BACKEND=none
# Node.js binary used to run the Remotion template
OPENCGP_VIDEO_NODE_BIN=node
# Remotion template project, relative to the repository root or absolute
# Public base URL used to turn relative media paths into absolute image URLs
OPENCGP_VIDEO_PUBLIC_BASE_URL=
OPENCGP_VIDEO_PROJECT=tools/remotion
# Render timeout in seconds
OPENCGP_VIDEO_TIMEOUT=300
# Frames rendered per video (30 fps: 150 = 5s, 300 = 10s)
OPENCGP_VIDEO_DURATION_FRAMES=300

# ---------- Code sandbox ----------
# docker | local | none
OPENCGP_EXECUTOR_BACKEND=docker
OPENCGP_EXEC_TIMEOUT=10
OPENCGP_EXEC_MAX_BYTES=65536
# Comma separated images allowed by the docker executor, e.g. python:3.11-alpine
OPENCGP_EXEC_IMAGES=

# ---------- Email notifications (optional) ----------
# none | smtp
OPENCGP_NOTIFY_BACKEND=none
OPENCGP_SMTP_HOST=
OPENCGP_SMTP_PORT=587
OPENCGP_SMTP_USER=
OPENCGP_SMTP_PASSWORD=
OPENCGP_SMTP_FROM=
# true = STARTTLS on submit. Implicit SSL/SMTPS is not supported
OPENCGP_SMTP_TLS=true
OPENCGP_SMTP_TIMEOUT=10
# Fallback recipients for pending-approval notices, comma separated
OPENCGP_NOTIFY_ADMIN_EMAIL=
