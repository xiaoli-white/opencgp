# OpenCGP 后端环境变量示例
# 用法：cp .env.example .env
# 统一前缀 OPENCGP_（旧前缀 COURSE_STUDIO_ 仍可识别，仅作回退）

# ---------- 应用 ----------
OPENCGP_APP_NAME=OpenCGP
OPENCGP_ENV=development
OPENCGP_LOG_LEVEL=info

# ---------- 鉴权 ----------
# disabled：本地单用户免登录；required：邮箱密码 + 审核制
OPENCGP_AUTH_MODE=required
# 令牌签名密钥，生产必须改成随机长串（openssl rand -base64 32）
OPENCGP_AUTH_SECRET=please-change-me
# 新用户是否需要管理员审核
OPENCGP_REQUIRE_APPROVAL=true

# ---------- 数据库 ----------
# sqlite | postgres
OPENCGP_DATABASE_BACKEND=postgres
OPENCGP_DATABASE_DSN=postgresql://opencgp:opencgp@127.0.0.1:55432/opencgp
OPENCGP_DATABASE_POOL_SIZE=8
# sqlite 模式下使用
#OPENCGP_DATABASE_PATH=data/opencgp.db

# ---------- 检索库 ----------
# simple：SQLite FTS5 + 可选向量；postgres：pg_trgm + 可选向量
OPENCGP_VECTORSTORE_BACKEND=postgres
#OPENCGP_VECTORSTORE_DSN=postgresql://opencgp:opencgp@127.0.0.1:55432/opencgp
#OPENCGP_VECTORSTORE_PATH=data/vectorstore
# 混合检索权重（可被「个人/空间设置」覆盖）
OPENCGP_HYBRID_VECTOR_WEIGHT=0.55
OPENCGP_HYBRID_LSH_BITS=12
OPENCGP_HYBRID_MAX_VECTOR_ROWS=200000

# ---------- 队列 ----------
# local | redis（多实例必须共用同一 Redis DB）
OPENCGP_QUEUE_BACKEND=redis
OPENCGP_REDIS_URL=redis://127.0.0.1:6379/0
# 0 表示该实例只做 API 不消费任务（API/Worker 分离）
OPENCGP_JOB_CONCURRENCY=2
OPENCGP_JOB_MAX_ATTEMPTS=3
OPENCGP_JOB_SSE_MAX_SECONDS=600

# ---------- 对象存储 ----------
# local | s3
OPENCGP_STORAGE_BACKEND=s3
OPENCGP_S3_ENDPOINT=http://127.0.0.1:9000
OPENCGP_S3_BUCKET=opencgp
OPENCGP_S3_REGION=us-east-1
OPENCGP_S3_ACCESS_KEY=
OPENCGP_S3_SECRET_KEY=
OPENCGP_S3_PREFIX=tenants
#OPENCGP_STORAGE_ROOT=data/storage

# ---------- 模型（默认通道，可被服务器/个人通道覆盖）----------
# openai_compat | dummy
OPENCGP_LLM_BACKEND=openai_compat
OPENCGP_LLM_BASE_URL=https://api.deepseek.com/v1
OPENCGP_LLM_MODEL=deepseek-chat
OPENCGP_LLM_API_KEY=
OPENCGP_LLM_TIMEOUT=120
OPENCGP_LLM_MAX_TOKENS=4096

# ---------- 联网搜索（可选）----------
# none | deepseek | generic
OPENCGP_WEBSEARCH_BACKEND=deepseek
OPENCGP_WEBSEARCH_URL=https://api.deepseek.com
OPENCGP_WEBSEARCH_API_KEY=
OPENCGP_WEBSEARCH_FETCH_ENABLED=true
OPENCGP_WEBSEARCH_FETCH_TOP=2
OPENCGP_WEBSEARCH_FETCH_CHARS=4000
# 其它厂商用 generic：OPENCGP_WEBSEARCH_URL / _API_KEY / _RESULT_PATH

# ---------- 向量化（可选，默认关闭）----------
# none | openai | hash（hash 仅用于离线验证，不是语义模型）
OPENCGP_EMBEDDING_BACKEND=none
OPENCGP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OPENCGP_EMBEDDING_MODEL=BAAI/bge-m3
OPENCGP_EMBEDDING_API_KEY=
OPENCGP_EMBEDDING_DIM=1024
OPENCGP_EMBEDDING_BATCH=32

# ---------- 重排（可选，默认关闭）----------
# none | cohere | jina | siliconflow | zhipu | tei | generic | llm
OPENCGP_RERANK_BACKEND=none
OPENCGP_RERANK_API_KEY=
OPENCGP_RERANK_WEIGHT=0.5
OPENCGP_RERANK_TOP_N=12
OPENCGP_RERANK_BATCH=100
OPENCGP_RERANK_CHARS=2000
OPENCGP_RERANK_NORMALIZE=auto
# 自定义端点时才需要：
#OPENCGP_RERANK_BASE_URL=
#OPENCGP_RERANK_MODEL=

# ---------- 邮件通知（可选）----------
# none | smtp
OPENCGP_NOTIFY_BACKEND=none
OPENCGP_SMTP_HOST=
OPENCGP_SMTP_PORT=587
OPENCGP_SMTP_USER=
OPENCGP_SMTP_PASSWORD=
OPENCGP_SMTP_FROM=OpenCGP <no-reply@example.com>
OPENCGP_SMTP_TLS=true
# 待审通知兜底收件人（逗号分隔）
OPENCGP_NOTIFY_ADMIN_EMAIL=

# ---------- 生图（可选）----------
# none | openai_images
OPENCGP_IMAGE_BACKEND=none
OPENCGP_IMAGE_BASE_URL=
OPENCGP_IMAGE_MODEL=
OPENCGP_IMAGE_API_KEY=

# ---------- 代码沙箱 ----------
# docker | local | none
OPENCGP_EXECUTOR_BACKEND=docker
OPENCGP_EXEC_TIMEOUT=10
OPENCGP_EXEC_MAX_BYTES=65536

# ---------- 配额 ----------
OPENCGP_QUOTA_PERIOD=monthly
OPENCGP_QUOTA_TIMEZONE=Asia/Shanghai
